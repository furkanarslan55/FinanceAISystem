@model UI.Models.Auth.UserLoginDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        :root {
            --bg-black: #000000; /* Tam siyah */
            --card-bg: #0a0a0a; /* Çok koyu gri/siyah kart */
            --input-bg: #121212; /* Giriş alanları */
            --border-color: #262626; /* İnce sınırlar */
            --primary-white: #ffffff; /* Ana metin ve buton */
            --text-gray: #a1a1aa; /* Yardımcı metinler */
            --error-red: #ff4545;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-black);
            color: var(--primary-white);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.25rem;
        }

        .login-container {
            width: 100%;
            max-width: 400px;
            padding: 2.5rem;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 1.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .header {
            text-align: center;
            margin-bottom: 2.5rem;
        }

            .header h1 {
                font-size: 1.75rem;
                font-weight: 700;
                letter-spacing: -0.05em;
            }

        .form-group {
            margin-bottom: 1.25rem;
        }

        .form-label {
            display: block;
            font-size: 0.85rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
            color: var(--text-gray);
        }

        .input-wrapper {
            position: relative;
        }

        .form-control {
            width: 100%;
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            border-radius: 0.75rem;
            padding: 0.9rem 1rem;
            color: var(--primary-white);
            font-size: 1rem;
            transition: all 0.2s ease;
        }

            .form-control:focus {
                outline: none;
                border-color: #404040;
                background-color: #1a1a1a;
            }

        .btn-submit {
            width: 100%;
            padding: 0.9rem;
            background-color: var(--primary-white);
            color: var(--bg-black);
            border: none;
            border-radius: 2rem; /* Grok/X tarzı oval buton */
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            margin-top: 1.5rem;
            transition: opacity 0.2s ease;
        }

            .btn-submit:hover {
                opacity: 0.9;
            }

        .error-text {
            color: var(--error-red);
            font-size: 0.8rem;
            margin-top: 0.4rem;
            display: block;
        }

        .validation-summary {
            color: var(--error-red);
            font-size: 0.9rem;
            margin-bottom: 1.5rem;
            padding: 0.75rem;
            border: 1px solid rgba(255, 69, 69, 0.2);
            border-radius: 0.5rem;
        }

        .footer {
            margin-top: 2rem;
            text-align: center;
            font-size: 0.85rem;
            color: var(--text-gray);
        }

            .footer a {
                color: var(--primary-white);
                text-decoration: none;
                font-weight: 600;
            }

        /* İkonlar için ufak dokunuş */
        .input-wrapper i {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #404040;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="header">
            <h1>Giriş Yap</h1>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <form asp-action="Login" method="post">
            <div class="form-group">
                <label class="form-label" asp-for="Email">E-posta</label>
                <div class="input-wrapper">
                    <input asp-for="Email" class="form-control" placeholder="E-posta adresiniz" />
                    <i class="fas fa-envelope"></i>
                </div>
                <span asp-validation-for="Email" class="error-text"></span>
            </div>

            <div class="form-group">
                <label class="form-label" asp-for="Password">Şifre</label>
                <div class="input-wrapper">
                    <input asp-for="Password" type="password" class="form-control" placeholder="Şifreniz" />
                    <i class="fas fa-lock"></i>
                </div>
                <span asp-validation-for="Password" class="error-text"></span>
            </div>

            <button type="submit" class="btn-submit">Giriş Yap</button>
        </form>

        <div class="footer">
            Hesabınız yok mu? <a href="#">Kaydol</a>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>