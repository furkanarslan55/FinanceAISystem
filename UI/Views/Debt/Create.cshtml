@model UI.Models.Debt.DebtCreateDto

@{
    ViewData["Title"] = "Yeni Borç Ekle";
    var categories = ViewBag.Categories as List<UI.Models.Debt.DebtCategoryDto>;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="bi bi-plus-square"></i> Yeni Borç Kaydı Oluştur</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Name" class="form-label fw-bold">Borç Adı / Alacaklı</label>
                                <input asp-for="Name" class="form-control" placeholder="Örn: Kira, Banka Kredisi" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Amount" class="form-label fw-bold">Tutar</label>
                                <div class="input-group">
                                    <span class="input-group-text">₺</span>
                                    <input asp-for="Amount" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Amount" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DueDate" class="form-label fw-bold">Son Ödeme Tarihi</label>
                                <input asp-for="DueDate" type="date" class="form-control" />
                                <span asp-validation-for="DueDate" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="DebtCategoryId" class="form-label fw-bold">Kategori</label>
                                <select asp-for="DebtCategoryId" class="form-select"
                                        asp-items="@(new SelectList(categories, "Id", "Name"))">
                                    <option value="">-- Kategori Seçiniz --</option>
                                </select>
                                <span asp-validation-for="DebtCategoryId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12 mb-4">
                                <label asp-for="Description" class="form-label fw-bold">Açıklama</label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Borç ile ilgili notlarınızı buraya yazın..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Debt" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Listeye Dön
                            </a>
                            <button type="submit" class="btn btn-success px-5">
                                <i class="bi bi-check-lg"></i> Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}