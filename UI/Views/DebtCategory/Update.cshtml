@using UI.Models.Debt;
@model DebtCategoryUpdateDto;
@{
    ViewData["Title"] = "Update Debt Category";
    
}

<h1>Update Debt Category</h1>


<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Kategori Düzenle</h4>
        </div>
        <div class="card-body">
            <form asp-controller="DebtCategory" asp-action="Update" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                
                <input type="hidden" asp-for="Id" />



                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Ad</label>
                    <input asp-for="Name" class="form-control" placeholder="Örn: Name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
               
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
              
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Değişiklikleri Kaydet
                    </button>
                    <a asp-controller="DebtCategory" asp-action="Index" class="btn btn-outline-secondary">
                        Vazgeç
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @* Sayfa yenilenmeden hata kontrolü (client-side validation) *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}