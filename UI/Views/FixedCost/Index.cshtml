@model List<UI.Models.FixedCost.FixedCostDto>

@{
    ViewData["Title"] = "Sabit Gider Listesi";
}

<style>
    body {
        background-color: #121212;
        color: #e0e0e0;
    }

    .custom-dark-card {
        background-color: #1e1e1e;
        border: 1px solid #333;
        border-radius: 12px;
    }

    .custom-dark-header {
        background-color: #252525 !important;
        border-bottom: 1px solid #333 !important;
        border-radius: 12px 12px 0 0 !important;
    }

    .text-accent {
        color: #00d1b2 !important;
    }

    .table-dark-custom {
        color: #e0e0e0;
    }

        .table-dark-custom thead {
            background-color: #2c2c2c;
            color: #00d1b2;
        }

        .table-dark-custom tbody tr {
            border-bottom: 1px solid #2a2a2a;
            transition: all 0.2s;
        }

            .table-dark-custom tbody tr:hover {
                background-color: #2c2c2c !important;
            }

    .btn-glow-success {
        background: #198754;
        border: none;
        color: white;
        box-shadow: 0 0 10px rgba(25, 135, 84, 0.2);
    }

        .btn-glow-success:hover {
            background: #157347;
            color: white;
            box-shadow: 0 0 15px rgba(25, 135, 84, 0.4);
        }

    .badge-debt-cat {
        background-color: #333;
        color: #00d1b2;
        border: 1px solid #444;
    }

    .amount-debt {
        font-family: 'JetBrains Mono', monospace;
        color: #ff4d4d;
    }
    /* Borç olduğu için kırmızı ton */
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-accent mb-0 fw-bold"><i class="bi bi-shield-exclamation me-2"></i>Giderlerim</h2>
            <small class="text-muted">Toplam @(Model?.Count ?? 0) aktif gider kaydı</small>
        </div>
        <a asp-action="Create" class="btn btn-glow-success px-4 py-2">
            <i class="bi bi-plus-lg me-1"></i> Yeni Gider
        </a>
    </div>

    <div class="card custom-dark-card shadow-lg">
        <div class="table-responsive">
            <table class="table table-dark-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th class="border-0">ID</th>
                        <th class="border-0">Gider Adı</th>
                        <th class="border-0">Kategori</th>
                        <th class="border-0 text-center">Miktar</th>     
                        <th class="border-0 text-center pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                               
                                    <div class="small text-muted">ID: #@item.Id</div>
                                </td>
                                <td>
                                    <span class="badge badge-debt-cat px-3 py-2">
                                        @item.Name
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="text-light small">
                                        <i class="bi bi-calendar3 text-accent me-1"></i>
                                        @item.CategoryName
                                    </div>
                                </td>
                                <td class="text-end fw-bold amount-debt fs-5">
                                    - @item.Amount.ToString("N2") ₺
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <form asp-controller="FixedCost" asp-action="Update" method="get" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-info btn-sm" title="Güncelle">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        </form>

                                        <form asp-controller="FixedCost" asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Sil">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="bi bi-clipboard-x fs-1 d-block mb-3 text-muted"></i>
                                <p class="text-muted">Henüz bir gider kaydı bulunmuyor.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>