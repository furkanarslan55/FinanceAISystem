@model UI.Models.FixedCost.FixedCostCategory.FixedCostCategoryCreateDto

@{
    ViewData["Title"] = "Yeni Borç Kategorisi Ekle";
}

<style>
    body {
        background-color: #121212;
        color: #e0e0e0;
    }

    .custom-dark-card {
        background-color: #1e1e1e;
        border: 1px solid #333;
        border-radius: 16px;
        overflow: hidden;
    }

    .custom-dark-header {
        background-color: #252525 !important;
        border-bottom: 1px solid #333 !important;
    }

    .text-accent {
        color: #00d1b2 !important;
    }

    /* Form Elemanları */
    .form-control {
        background-color: #2a2a2a !important;
        border: 1px solid #444 !important;
        color: #fff !important;
        border-radius: 10px;
        padding: 12px 15px;
        transition: all 0.3s;
    }

        .form-control:focus {
            background-color: #333 !important;
            border-color: #00d1b2 !important;
            box-shadow: 0 0 0 0.25rem rgba(0, 209, 178, 0.1);
            color: #fff !important;
        }

    .form-label {
        color: #b0b0b0;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    /* Butonlar */
    .btn-save-cat {
        background-color: #00d1b2;
        border: none;
        color: #121212;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-save-cat:hover {
            background-color: #00bfa5;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(0, 209, 178, 0.2);
            color: #121212;
        }

    .btn-cancel {
        border: 1px solid #444;
        color: #999;
        border-radius: 10px;
        transition: all 0.2s;
    }

        .btn-cancel:hover {
            background-color: #333;
            color: #fff;
        }

    .category-icon-header {
        width: 60px;
        height: 60px;
        background: rgba(0, 209, 178, 0.1);
        color: #00d1b2;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        margin: 0 auto 15px;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card custom-dark-card shadow-lg">
                <div class="card-header custom-dark-header py-4 text-center">
                    <div class="category-icon-header">
                        <i class="bi bi-tag-plus fs-2"></i>
                    </div>
                    <h4 class="mb-0 fw-bold text-white">Yeni Sabit Gider Kategorisi</h4>
                    <p class="text-muted small mb-0 mt-2">Borçlarınızı daha iyi organize etmek için bir başlık oluşturun</p>
                </div>

                <div class="card-body p-4 p-lg-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger small"></div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label">Kategori Adı</label>
                            <input asp-for="Name" class="form-control" placeholder="Örn: Banka Borçları, Şahsi Borçlar..." autofocus />
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label">Açıklama (Opsiyonel)</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Bu kategori hangi tür borçları kapsıyor?"></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-grid gap-3 mt-5">
                            <button type="submit" class="btn btn-save-cat py-3">
                                <i class="bi bi-check-lg me-2"></i>Kategoriyi Kaydet
                            </button>
                            <a asp-action="Index" class="btn btn-cancel py-2 text-center">
                                <i class="bi bi-arrow-left me-1"></i> Listeye Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <p class="text-muted small">
                    <i class="bi bi-shield-check me-1 text-accent"></i>
                    Kategoriler finansal analizlerinizde doğru gruplandırma sağlar.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}