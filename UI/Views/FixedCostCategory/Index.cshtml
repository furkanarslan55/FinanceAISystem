@using UI.Models.FixedCost.FixedCostCategory;
@model List<FixedCostCategoryViewDto>;
@{
    ViewData["Title"] = "Fixed Cost Categories";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-white fw-bold">Fixed Cost Categories</h1>
            <p class="text-muted small">Yönetim panelinden tüm sabit maliyet kategorilerini düzenleyebilirsiniz.</p>
        </div>
        <a asp-controller="FixedCostCategory" asp-action="Create" class="btn btn-success px-4 shadow-sm">
            <i class="fas fa-plus me-2"></i>Yeni Ekle
        </a>
    </div>

    <div class="card bg-dark border-secondary shadow-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead class="bg-black text-uppercase small fw-lighter border-bottom border-secondary">
                        <tr>
                            <th class="ps-4 py-3 text-muted">ID</th>
                            <th class="py-3 text-muted">Name</th>
                            <th class="py-3 text-muted">Description</th>
                            <th class="pe-4 py-3 text-end text-muted">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td class="ps-4 text-secondary">#@category.Id</td>
                                <td>
                                    <span class="fw-semibold text-white">@category.Name</span>
                                </td>
                                <td>
                                    <span class="text-muted small">@(category.Description ?? "Açıklama yok")</span>
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group shadow-sm" role="group">
                                        <form asp-controller="FixedCostCategory" asp-action="UpdateForm" method="get" class="d-inline">
                                            <input type="hidden" name="id" value="@category.Id" />
                                            <button type="submit" class="btn btn-outline-info btn-sm" title="Güncelle">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        </form>

                                        <form asp-controller="FixedCostCategory" asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                                            <input type="hidden" name="id" value="@category.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Sil">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    /* Modern Koyu Tema İyileştirmeleri */
    body {
        background-color: #121212; /* Çok koyu gri/siyah arka plan */
    }

    .table-hover tbody tr:hover {
        background-color: #1f1f1f !important; /* Satır üzerine gelince hafif aydınlanma */
        transition: background-color 0.3s ease;
    }

    .card {
        border-radius: 12px;
        overflow: hidden;
    }

    .btn-group .btn {
        transition: all 0.2s ease;
    }

        .btn-group .btn:hover {
            transform: translateY(-1px);
        }
</style>