@model UI.Models.Incomes.IncomeCreateDto

@{
    ViewData["Title"] = "Gelir Ekle";
    var categories = ViewBag.Categories as List<UI.Models.Incomes.IncomeCategoryViewDto>;
}

<style>
    body {
        background-color: #121212;
        color: #e0e0e0;
    }

    .custom-dark-card {
        background-color: #1e1e1e;
        border: 1px solid #333;
        border-radius: 16px;
        overflow: hidden;
    }

    .custom-dark-header {
        background-color: #252525 !important;
        border-bottom: 1px solid #333 !important;
    }

    .text-accent {
        color: #00d1b2 !important;
    }

    /* Form Elemanları Modernizasyonu */
    .form-control, .form-select {
        background-color: #2a2a2a !important;
        border: 1px solid #444 !important;
        color: #fff !important;
        border-radius: 8px;
        padding: 12px 15px;
    }

        .form-control:focus, .form-select:focus {
            background-color: #333 !important;
            border-color: #00d1b2 !important;
            box-shadow: 0 0 0 0.25rem rgba(0, 209, 178, 0.15);
            color: #fff !important;
        }

    .input-group-text {
        background-color: #333 !important;
        border: 1px solid #444 !important;
        color: #00d1b2 !important;
        font-weight: bold;
    }

    .form-label {
        color: #b0b0b0;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    /* Butonlar */
    .btn-save {
        background-color: #00d1b2;
        border: none;
        color: #121212;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-save:hover {
            background-color: #00bfa5;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(0, 209, 178, 0.3);
            color: #121212;
        }

    .btn-cancel {
        border: 1px solid #444;
        color: #999;
    }

        .btn-cancel:hover {
            background-color: #333;
            color: #fff;
        }

    ::placeholder {
        color: #666 !important;
        opacity: 1;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="card custom-dark-card shadow-lg">
                <div class="card-header custom-dark-header py-4 text-center">
                    <h4 class="mb-0 fw-bold text-accent">
                        <i class="bi bi-plus-circle-fill me-2"></i>Yeni Gelir Kaydı
                    </h4>
                    <p class="text-muted small mb-0 mt-2">Sisteme yeni bir gelir girişi yapın</p>
                </div>

                <div class="card-body p-4 p-lg-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger small"></div>

                        <div class="mb-4">
                            <label asp-for="Amount" class="form-label">İşlem Tutarı</label>
                            <div class="input-group">
                                <span class="input-group-text">₺</span>
                                <input asp-for="Amount" type="number" step="0.01" class="form-control form-control-lg amount-input" placeholder="0.00" autofocus />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="IncomeCategoryId" class="form-label">Kategori</label>
                            <select asp-for="IncomeCategoryId" class="form-select"
                                    asp-items="@(new SelectList(categories, "Id", "Name"))">
                                <option value="" disabled selected>Kategori seçiniz...</option>
                            </select>
                            <span asp-validation-for="IncomeCategoryId" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Date" class="form-label">İşlem Tarihi</label>
                            <input asp-for="Date" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="Date" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Örn: Serbest zamanlı proje ödemesi..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-grid gap-3 mt-5">
                            <button type="submit" class="btn btn-save py-3">
                                <i class="bi bi-check2-circle me-2"></i>Geliri Kaydet
                            </button>
                            <a asp-action="Index" class="btn btn-cancel py-2">İptal</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <p class="text-muted small">
                    <i class="bi bi-shield-lock me-1"></i> Tüm verileriniz güvenli bir şekilde şifrelenir.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}