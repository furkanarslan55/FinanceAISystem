@model List<UI.Models.Incomes.IncomeViewDto>

@{
    ViewData["Title"] = "Gelir Hareketlerim";
}

<style>
    body {
        background-color: #121212;
        color: #e0e0e0;
    }

    .custom-dark-card {
        background-color: #1e1e1e;
        border: 1px solid #333;
        border-radius: 12px;
    }

    .custom-dark-header {
        background-color: #252525 !important;
        border-bottom: 1px solid #333 !important;
        border-radius: 12px 12px 0 0 !important;
    }

    .table-dark-custom {
        color: #e0e0e0;
    }

        .table-dark-custom thead {
            background-color: #2c2c2c;
            color: #00d1b2;
        }

        .table-dark-custom tbody tr {
            border-bottom: 1px solid #2a2a2a;
            transition: all 0.2s;
        }

            .table-dark-custom tbody tr:hover {
                background-color: #2c2c2c !important;
            }

    .text-accent {
        color: #00d1b2 !important;
    }

    .btn-glow-success {
        background: #198754;
        border: none;
        box-shadow: 0 0 10px rgba(25, 135, 84, 0.2);
    }

        .btn-glow-success:hover {
            background: #157347;
            box-shadow: 0 0 15px rgba(25, 135, 84, 0.4);
        }

    .badge-category {
        background-color: #333;
        color: #00d1b2;
        border: 1px solid #444;
    }

    .amount-text {
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: -0.5px;
    }
</style>

<div class="card custom-dark-card shadow-lg mt-4">
    <div class="card-header custom-dark-header d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold text-accent">
            <i class="bi bi-wallet2 me-2"></i>Gelir Listesi
        </h5>
        <a asp-action="Create" class="btn btn-glow-success btn-sm px-3 text-white">
            <i class="bi bi-plus-lg me-1"></i> Yeni Gelir Ekle
        </a>
    </div>

    <div class="card-body p-0">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-dark border-success mx-3 mt-3 alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill text-success me-2"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-dark-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4 py-3 border-0">Tarih</th>
                        <th class="border-0">Kategori</th>
                        <th class="border-0">Açıklama</th>
                        <th class="text-end border-0">Miktar</th>
                        <th class="text-center border-0 pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model.OrderByDescending(x => x.IncomeDate))
                        {
                            <tr>
                                <td class="ps-4 text-muted">@item.IncomeDate.ToShortDateString()</td>
                                <td>
                                    <span class="badge badge-category px-3 py-2">
                                        @item.CategoryName
                                    </span>
                                </td>
                                <td>
                                    <span class="text-secondary small">
                                        @(string.IsNullOrEmpty(item.Description) ? "—" : item.Description)
                                    </span>
                                </td>
                                <td class="text-end fw-bold amount-text text-success">
                                    + @item.Amount.ToString("C2")
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <form asp-controller="Income" asp-action="UpdateForm" method="get" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-info btn-sm" title="Düzenle">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        </form>

                                        <form asp-controller="Income" asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Bu kaydı silmek istediğinizden emin misiniz?');">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Sil">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-3 text-muted"></i>
                                <p class="text-muted">Henüz bir gelir kaydı bulunmuyor.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Alert mesajını 3 saniye sonra otomatik kapat
        setTimeout(function () {
            $('.alert').fadeOut('slow');
        }, 3000);
    </script>
}