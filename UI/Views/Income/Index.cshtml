@model List<UI.Models.Incomes.IncomeViewDto>

@{
    ViewData["Title"] = "Gelir Hareketlerim";
}

<div class="card shadow-sm mt-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold text-primary">Gelir Listesi</h5>
        <a asp-action="Create" class="btn btn-success btn-sm">
            <i class="bi bi-plus-lg"></i> Yeni Gelir Ekle
        </a>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Tarih</th>
                        <th>Kategori</th>
                        <th>Açıklama</th>
                        <th class="text-end">Miktar</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model.OrderByDescending(x => x.Date))
                        {
                            <tr>
                                <td>@item.Date.ToShortDateString()</td>
                                <td>
                                    <span class="badge rounded-pill bg-info text-dark">
                                        @item.CategoryName
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    @(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)
                                </td>
                                <td class="text-end fw-bold text-success">
                                    @item.Amount.ToString("C2")
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <!-- Düzenle formu -->
                                        <form asp-action="Update" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-primary btn-sm" title="Düzenle">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </form>

                                        <!-- Silme formu -->
                                        <form asp-controller="Income" asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Sil">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <p class="mb-0">Henüz bir gelir kaydı bulunmuyor.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Alert mesajını 3 saniye sonra otomatik kapat
        setTimeout(function () {
            $('.alert').alert('close');
        }, 3000);
    </script>
}