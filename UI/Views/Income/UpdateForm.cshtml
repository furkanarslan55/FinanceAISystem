@using UI.Models.Incomes;
@model IncomeViewDto;
@{
    ViewData["Title"] = "Update Income";
    var categories = ViewBag.Categories as List<UI.Models.Incomes.IncomeCategoryViewDto>;
}



<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Kategori Düzenle</h4>
        </div>
        <div class="card-body">
            <form asp-controller="Income" asp-action="Update" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>


                <input type="hidden" asp-for="Id" />

        

                <div class="mb-3">
                    <label asp-for="Amount" class="form-label">Miktar</label>
                    <input asp-for="Amount" class="form-control" placeholder="Örn: Maaş, Freelance..." />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="IncomeDate" class="form-label">Tarih </label>
                    <input asp-for="IncomeDate" class="form-control" placeholder="Örn: Maaş, Freelance..." />
                    <span asp-validation-for="IncomeDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="CategoryName" class="form-label fw-bold">Kategori Seçimi</label>
                    <select asp-for="CategoryName" class="form-select"
                            asp-items="@(new SelectList(categories, "Id", "Name"))">
                        <option value="">@Model.CategoryName</option>
                    </select>
                    <span asp-validation-for="CategoryName" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Değişiklikleri Kaydet
                    </button>
                    <a asp-controller="Income" asp-action="Index" class="btn btn-outline-secondary">
                        Vazgeç
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @* Sayfa yenilenmeden hata kontrolü (client-side validation) *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}