@model UI.Models.ViewModel.Income.IncomeCategoryCreateDto

@{
    ViewData["Title"] = "Yeni Kategori Ekle";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Yeni Gelir Kategorisi Oluştur</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">

                        @* API'den veya validasyondan gelen hataları göstermek için *@
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label">Kategori Adı</label>
                            <input asp-for="Name" class="form-control" placeholder="Örn: Maaş, Kira Geliri..." />
                            @* Client-side validasyon hatası *@
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label">Kategori Adı</label>
                            <input asp-for="Description" class="form-control" placeholder="Örn: Maaş, Kira Geliri..." />
                            @* Client-side validasyon hatası *@
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Listeye Dön
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Sayfa yenilenmeden hata kontrolü yapmak için (Validasyon için gerekli) *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}