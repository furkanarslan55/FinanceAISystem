@model List<UI.Models.Incomes.IncomeCategoryViewDto>

<h2>Gelir Kategorilerim</h2>
<a asp-action="Create" class="btn btn-primary">Yeni Kategori Ekle</a>

<table class="table mt-3">
    <thead>
        <tr>
            <th>Kategori Adı</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Sil</a>
                </td>
                <td>
                    <a asp-action="UpdateForm" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                        <i class="fas fa-edit"></i> Düzenle
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>