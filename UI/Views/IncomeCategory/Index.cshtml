@model List<UI.Models.ViewModel.Income.IncomeCategoryViewDto>

@{
    ViewData["Title"] = "Gelir Kategorileri";
}

<h1>Gelir Kategorileri</h1>

<a asp-action="Create" class="btn btn-primary mb-3">Yeni Kategori Ekle</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Kategori Adı</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>
                    <a class="btn btn-warning btn-sm">Düzenle</a>
                    <a class="btn btn-danger btn-sm">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>