@model List<UI.Models.Incomes.IncomeCategoryViewDto>

@{
    ViewData["Title"] = "Gelir Kategorilerim";
}

<style>
    body {
        background-color: #121212;
        color: #e0e0e0;
    }

    .custom-dark-card {
        background-color: #1e1e1e;
        border: 1px solid #333;
        border-radius: 12px;
    }

    .custom-dark-header {
        background-color: #252525 !important;
        border-bottom: 1px solid #333 !important;
        border-radius: 12px 12px 0 0 !important;
    }

    .text-accent {
        color: #00d1b2 !important;
    }

    .table-dark-custom {
        color: #e0e0e0;
    }

        .table-dark-custom thead {
            background-color: #2c2c2c;
            color: #00d1b2;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .table-dark-custom tbody tr {
            border-bottom: 1px solid #2a2a2a;
            transition: background 0.2s;
        }

            .table-dark-custom tbody tr:hover {
                background-color: #252525 !important;
            }

    .category-avatar {
        width: 35px;
        height: 35px;
        background: #333;
        color: #00d1b2;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-weight: bold;
        margin-right: 12px;
    }

    .btn-action {
        padding: 5px 10px;
        border-radius: 6px;
        transition: all 0.2s;
    }

    .btn-edit-custom {
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.2);
    }

        .btn-edit-custom:hover {
            background: rgba(255, 193, 7, 0.1);
            color: #ffc107;
        }

    .btn-delete-custom {
        color: #ff4d4d;
        border: 1px solid rgba(255, 77, 77, 0.2);
    }

        .btn-delete-custom:hover {
            background: rgba(255, 77, 77, 0.1);
            color: #ff4d4d;
        }

    .btn-add-main {
        background-color: #00d1b2;
        border: none;
        color: #121212;
        font-weight: 600;
    }

        .btn-add-main:hover {
            background-color: #00bfa5;
            color: #121212;
            box-shadow: 0 4px 12px rgba(0, 209, 178, 0.2);
        }
</style>

<div class="card custom-dark-card shadow-lg mt-4">
    <div class="card-header custom-dark-header d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold text-accent">
            <i class="bi bi-tags-fill me-2"></i>Gelir Kategorileri
        </h5>
        <a asp-action="Create" class="btn btn-add-main btn-sm px-3">
            <i class="bi bi-plus-lg me-1"></i> Yeni Kategori Ekle
        </a>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4 py-3 border-0">Kategori Tanımı</th>
                        <th class="text-end border-0 pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="category-avatar">
                                            @item.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="fw-medium text-white">@item.Name</span>
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="UpdateForm" asp-route-id="@item.Id"
                                           class="btn btn-action btn-edit-custom btn-sm" title="Düzenle">
                                            <i class="bi bi-pencil-square"></i>
                                            <span class="d-none d-md-inline ms-1">Düzenle</span>
                                        </a>

                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-action btn-delete-custom btn-sm"
                                           onclick="return confirm('Bu kategoriyi silmek istediğinizden emin misiniz?');"
                                           title="Sil">
                                            <i class="bi bi-trash3"></i>
                                            <span class="d-none d-md-inline ms-1">Sil</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center py-5">
                                <p class="text-muted">Tanımlı kategori bulunamadı.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 ps-2">
    <a asp-controller="Income" asp-action="Index" class="text-muted small text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i> Gelir Listesine Dön
    </a>
</div>