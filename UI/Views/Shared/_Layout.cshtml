@* _Layout.cshtml *@
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gelir Gider Takip</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-collapsed-width: 70px;
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --bg: #f8fafc;
            --text: #1e293b;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: system-ui, sans-serif;
        }

        #sidebar {
            width: var(--sidebar-width);
            transition: width 0.3s ease, transform 0.3s ease;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 1000;
            overflow-y: auto;
            background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
            color: white;
        }

            #sidebar.collapsed {
                width: var(--sidebar-collapsed-width);
            }

                #sidebar.collapsed .sidebar-text,
                #sidebar.collapsed .dropdown-toggle::after {
                    display: none;
                }

                #sidebar.collapsed .nav-link {
                    justify-content: center;
                }

        #main-content {
            margin-left: var(--sidebar-width);
            transition: margin-left 0.3s ease;
            min-height: 100vh;
        }

        #sidebar.collapsed ~ #main-content {
            margin-left: var(--sidebar-collapsed-width);
        }

        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .nav-link {
            color: rgba(255,255,255,0.85) !important;
            transition: all 0.2s;
        }

            .nav-link:hover,
            .nav-link.active {
                color: white !important;
                background: rgba(255,255,255,0.1);
                border-radius: 0.5rem;
            }

        .submenu {
            background: rgba(0,0,0,0.2);
            border-radius: 0.5rem;
            margin: 0.25rem 0;
        }

        .user-dropdown .dropdown-menu {
            border: none;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            border-radius: 0.75rem;
        }

        .toggle-btn {
            background: none;
            border: none;
            color: white;
            font-size: 1.4rem;
            cursor: pointer;
        }

        @@media (max-width: 992px) {
            #sidebar {
                transform: translateX(-100%);
            }

                #sidebar.show {
                    transform: translateX(0);
                }

            #main-content {
                margin-left: 0 !important;
            }
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <aside id="sidebar" class="d-flex flex-column p-3">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h4 class="mb-0 navbar-brand text-white">Gelir-Gider</h4>
            <button class="toggle-btn d-none d-lg-block" id="sidebarToggle">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <!-- Mobil için kapat butonu -->
        <button class="btn-close btn-close-white d-lg-none ms-auto mb-3" id="sidebarClose"></button>

        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-home me-3 fs-5"></i>
                    <span class="sidebar-text">Ana Sayfa</span>
                </a>
            </li>

            <!-- Gelirler -->
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center dropdown-toggle" href="#gelirMenu" data-bs-toggle="collapse">
                    <i class="fas fa-arrow-up me-3 fs-5"></i>
                    <span class="sidebar-text">Gelirler</span>
                </a>
                <ul class="collapse submenu nav flex-column ms-4" id="gelirMenu">
                    <li><a class="nav-link" asp-controller="Income" asp-action="Index">Tüm Gelirler</a></li>
                    <li><a class="nav-link" asp-controller="IncomeCategory" asp-action="Create">Yeni Gelir Kategorisi Ekle</a></li>
                    <li><a class="nav-link" asp-controller="Income" asp-action="Create">Yeni Gelir</a></li>
                </ul>
            </li>

            <!-- Borçlar -->
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center dropdown-toggle" href="#borcMenu" data-bs-toggle="collapse">
                    <i class="fas fa-hand-holding-dollar me-3 fs-5"></i>
                    <span class="sidebar-text">Borçlar</span>
                </a>
                <ul class="collapse submenu nav flex-column ms-4" id="borcMenu">
                    <li><a class="nav-link" asp-controller="Debt" asp-action="Index">Tüm Borçlar</a></li>
                    <li><a class="nav-link" asp-controller="Debt" asp-action="Create">Yeni Borç Ekle</a></li>
                </ul>
            </li>

            <!-- Sabit Giderler -->
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center dropdown-toggle" href="#giderMenu" data-bs-toggle="collapse">
                    <i class="fas fa-arrow-down me-3 fs-5"></i>
                    <span class="sidebar-text">Sabit Giderler</span>
                </a>
                <ul class="collapse submenu nav flex-column ms-4" id="giderMenu">
                    <li><a class="nav-link" asp-controller="FixedCost" asp-action="Index">Liste</a></li>
                    <li><a class="nav-link" asp-controller="FixedCost" asp-action="Create">Yeni Ekle</a></li>
                    <li><a class="nav-link" asp-controller="ExpenseCategory" asp-action="Index">Kategoriler</a></li>
                </ul>
            </li>

            <li class="nav-item mt-auto">
                <a class="nav-link d-flex align-items-center" asp-controller="Home" asp-action="Privacy">
                    <i class="fas fa-shield-halved me-3 fs-5"></i>
                    <span class="sidebar-text">Gizlilik</span>
                </a>
            </li>
        </ul>
    </aside>

    <!-- Main Wrapper -->
    <div id="main-content" class="d-flex flex-column">

        <!-- Top Navbar -->
        <nav class="navbar navbar-expand navbar-light bg-white shadow-sm px-4">
            <div class="container-fluid">

                <!-- Mobil hamburger -->
                <button class="navbar-toggler d-lg-none me-3" type="button" id="sidebarToggleMobile">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="d-flex align-items-center flex-grow-1">
                    <!-- Boş alan (ortası boş kalacak) -->
                </div>

                <!-- Kullanıcı profili -->
                <div class="dropdown user-dropdown ms-auto">
                    <a class="d-flex align-items-center text-decoration-none dropdown-toggle" href="#" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="https://ui-avatars.com/api/?name=Furkan+Arslan&background=4f46e5&color=fff&size=128" alt="User" class="rounded-circle me-2" width="38" height="38">
                        <span class="d-none d-md-inline fw-medium">furkan</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i> Profil</a></li>
                        <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2"></i> Ayarlar</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt me-2"></i> Çıkış Yap</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Page Content -->
        <main class="flex-grow-1 p-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Sidebar toggle (desktop)
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('collapsed');
        });

        // Mobil sidebar aç/kapa
        const sidebar = document.getElementById('sidebar');
        document.getElementById('sidebarToggleMobile')?.addEventListener('click', function () {
            sidebar.classList.add('show');
        });

        document.getElementById('sidebarClose')?.addEventListener('click', function () {
            sidebar.classList.remove('show');
        });

        // Dışarı tıklayınca kapat (mobil)
        document.addEventListener('click', function (e) {
            if (window.innerWidth < 992) {
                if (!sidebar.contains(e.target) && !document.getElementById('sidebarToggleMobile')?.contains(e.target)) {
                    sidebar.classList.remove('show');
                }
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>