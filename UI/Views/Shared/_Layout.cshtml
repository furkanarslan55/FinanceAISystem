@* _Layout.cshtml *@
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Finans Takip</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --sidebar-width: 280px;
            --sidebar-bg: #0f172a; /* Derin Gece Mavisi/Siyah */
            --primary-color: #818cf8; /* Parlak Indigo */
            --accent-color: #2dd4bf; /* Turkuaz Vurgu */
            --text-main: #f1f5f9; /* Off-white Metin */
            --text-muted: #94a3b8; /* Gri Metin */
            --bg-body: #020617; /* Saf Siyah-Lacivert arası */
            --card-bg: #1e293b; /* Kartlar için Antrasit */
            --border-color: #1e293b;
            --nav-hover: #1e293b;
        }

        body {
            background-color: var(--bg-body);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', sans-serif;
            letter-spacing: -0.02em;
        }

        /* Sidebar Styling */
        #sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 1050;
            transition: all 0.3s ease;
        }

        .sidebar-header {
            padding: 2rem 1.5rem;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .brand-logo {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, var(--primary-color), #4f46e5);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            color: white;
            box-shadow: 0 4px 15px rgba(129, 140, 248, 0.4);
        }

        /* Nav Links */
        .nav-pills .nav-link {
            color: var(--text-muted);
            padding: 0.8rem 1.2rem;
            margin: 0.3rem 1rem;
            border-radius: 12px;
            font-weight: 500;
            display: flex;
            align-items: center;
            transition: all 0.2s ease;
        }

            .nav-pills .nav-link i {
                width: 28px;
                font-size: 1.1rem;
                margin-right: 8px;
                transition: transform 0.2s;
            }

            .nav-pills .nav-link:hover {
                background-color: var(--nav-hover);
                color: var(--primary-color);
            }

            .nav-pills .nav-link.active {
                background-color: rgba(129, 140, 248, 0.15);
                color: var(--primary-color);
                border: 1px solid rgba(129, 140, 248, 0.3);
            }

        .submenu {
            list-style: none;
            padding-left: 3.2rem;
            margin-bottom: 0.5rem;
        }

            .submenu .nav-link {
                padding: 0.5rem 0;
                margin: 0;
                font-size: 0.85rem;
                background: transparent !important;
                border: none !important;
            }

                .submenu .nav-link:hover {
                    color: var(--text-main);
                }

        /* Main Content */
        #main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
        }

        .top-navbar {
            background: rgba(2, 6, 23, 0.8);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            padding: 1rem 1.5rem;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        /* Dropdown Styling */
        .dropdown-menu {
            background-color: var(--sidebar-bg);
            border: 1px solid var(--border-color);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
            border-radius: 14px;
            padding: 0.5rem;
        }

        .dropdown-item {
            color: var(--text-muted);
            border-radius: 8px;
            padding: 0.7rem 1rem;
        }

            .dropdown-item:hover {
                background-color: var(--nav-hover);
                color: var(--primary-color);
            }

        /* Section Labels */
        .nav-label {
            text-transform: uppercase;
            font-size: 0.65rem;
            font-weight: 800;
            color: #475569;
            margin: 2rem 2rem 0.5rem;
            letter-spacing: 0.1em;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 10px;
        }

        @@media (max-width: 992px) {
            #sidebar {
                transform: translateX(-100%);
            }

                #sidebar.show {
                    transform: translateX(0);
                }

            #main-content {
                margin-left: 0 !important;
            }
        }
    </style>
</head>
<body>

    <aside id="sidebar">
        <div class="sidebar-header">
            <div class="brand-logo"><i class="fas fa-bolt"></i></div>
            <h5 class="mb-0 fw-bold" style="letter-spacing: 1px;">FIN<span style="color: var(--primary-color)">TRACK</span></h5>
            <button class="btn-close btn-close-white d-lg-none ms-auto" id="sidebarClose"></button>
        </div>

        <div class="py-3">
            <ul class="nav nav-pills flex-column">
                <li class="nav-item">
                    <a class="nav-link active" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-th-large"></i> <span>Dashboard</span>
                    </a>
                </li>

                <div class="nav-label">Finansal Yönetim</div>

                <li class="nav-item">
                    <a class="nav-link" href="#gelirMenu" data-bs-toggle="collapse">
                        <i class="fas fa-arrow-up-right-dots"></i> <span>Gelirler</span>
                        <i class="fas fa-chevron-down ms-auto fa-xs opacity-50"></i>
                    </a>
                    <div class="collapse" id="gelirMenu">
                        <ul class="submenu">
                            <li><a class="nav-link" asp-controller="Income" asp-action="Index">Özet</a></li>
                            <li><a class="nav-link" asp-controller="IncomeCategory" asp-action="Index">Kategoriler</a></li>
                            <li><a class="nav-link" asp-controller="Income" asp-action="Create">Ekle</a></li>
                        </ul>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#borcMenu" data-bs-toggle="collapse">
                        <i class="fas fa-hand-holding-dollar"></i> <span>Borçlar</span>
                        <i class="fas fa-chevron-down ms-auto fa-xs opacity-50"></i>
                    </a>
                    <div class="collapse" id="borcMenu">
                        <ul class="submenu">
                            <li><a class="nav-link" asp-controller="Debt" asp-action="Index">Liste</a></li>
                            <li><a class="nav-link" asp-controller="DebtCategory" asp-action="Index">Kategoriler</a></li>
                        </ul>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#giderMenu" data-bs-toggle="collapse">
                        <i class="fas fa-wallet"></i> <span>Giderler</span>
                        <i class="fas fa-chevron-down ms-auto fa-xs opacity-50"></i>
                    </a>
                    <div class="collapse" id="giderMenu">
                        <ul class="submenu">
                            <li><a class="nav-link" asp-controller="FixedCost" asp-action="Index">Sabit Giderler</a></li>
                            <li><a class="nav-link" asp-controller="FixedCostCategory" asp-action="Index">Kategoriler</a></li>
                            <li><a class="nav-link" asp-controller="FixedCost" asp-action="Create">Yeni Kayıt</a></li>
                        </ul>
                    </div>
                </li>

                <div class="nav-label">Zeka</div>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                        <i class="fas fa-microchip" style="color: var(--accent-color)"></i> <span style="color: var(--accent-color)">AI Analiz</span>
                    </a>
                </li>
            </ul>
        </div>
    </aside>

    <div id="main-content">
        <nav class="navbar navbar-expand top-navbar">
            <div class="container-fluid">
                <button class="btn btn-dark d-lg-none me-3" id="sidebarToggleMobile">
                    <i class="fas fa-bars"></i>
                </button>

                <div class="d-none d-md-block">
                    <span class="text-muted">Sistem Durumu:</span> <span class="badge bg-success bg-opacity-10 text-success ms-1">Aktif</span>
                </div>

                <div class="dropdown ms-auto">
                    <a class="d-flex align-items-center text-decoration-none" href="#" id="userDropdown" data-bs-toggle="dropdown">
                        <div class="text-end me-3 d-none d-sm-block">
                            <div class="fw-bold mb-0 small text-white">Furkan Arslan</div>
                            <div class="text-primary small fw-bold" style="font-size: 10px; text-transform: uppercase;">Yönetici</div>
                        </div>
                        <img src="https://ui-avatars.com/api/?name=Furkan+Arslan&background=1e293b&color=818cf8" class="rounded-circle border border-secondary" width="38" height="38">
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow">
                        <li><a class="dropdown-item" href="#"><i class="fas fa-user-circle me-2"></i> Profil</a></li>
                        <li><a class="dropdown-item" href="#"><i class="fas fa-gear me-2"></i> Ayarlar</a></li>
                        <li><hr class="dropdown-divider border-secondary"></li>
                        <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="fas fa-power-off me-2"></i> Güvenli Çıkış</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="p-4">
            <div class="container-fluid">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const sidebar = document.getElementById('sidebar');
        const mobileBtn = document.getElementById('sidebarToggleMobile');
        const closeBtn = document.getElementById('sidebarClose');

        mobileBtn?.addEventListener('click', () => sidebar.classList.add('show'));
        closeBtn?.addEventListener('click', () => sidebar.classList.remove('show'));

        document.addEventListener('click', (e) => {
            if (window.innerWidth < 992 && !sidebar.contains(e.target) && !mobileBtn?.contains(e.target)) {
                sidebar.classList.remove('show');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>