<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Borç Takip</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa; /* Hafif gri arka plan gözü yormaz */
            color: #343a40;
        }

        /* Navbar: Temiz beyaz zemin üzerine ince gölge */
        .navbar {
            background-color: #ffffff !important;
            border-bottom: 1px solid #e9ecef;
            padding: 0.8rem 1rem;
        }

        .navbar-brand {
            font-weight: 700;
            color: #0d6efd !important;
            letter-spacing: -0.5px;
        }

        .nav-link {
            color: #6c757d !important;
            font-weight: 500;
            transition: color 0.2s ease;
            margin: 0 5px;
        }

            .nav-link:hover, .nav-link.active {
                color: #0d6efd !important;
            }

        /* Login Butonu Özelleştirme */
        .btn-login {
            background-color: #0d6efd;
            color: white !important;
            border-radius: 8px;
            padding: 0.5rem 1.5rem;
            font-weight: 600;
        }

        /* İçerik Alanı */
        .main-content {
            padding-top: 3rem;
            padding-bottom: 5rem;
            min-height: calc(100vh - 160px);
        }

        /* Footer: Sade ve minimal */
        footer {
            background-color: #ffffff;
            border-top: 1px solid #e9ecef;
            padding: 2rem 0;
            color: #adb5bd;
            font-size: 0.9rem;
        }

        /* Kart Yapıları (Eğer sayfalarında kullanırsan uyumlu olsun) */
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg sticky-top shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-graph-up-arrow me-2"></i> BT-SİSTEMİ
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Borçlar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Raporlar</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Auth" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Giriş
                            </a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-login shadow-sm shadow-hover" href="#">
                                Ücretsiz Dene
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer>
        <div class="container text-center">
            <div class="mb-2">
                <strong>Borç Takip Sistemi</strong> &copy; @DateTime.Now.Year
            </div>
            <div class="links">
                <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted mx-2">Gizlilik</a>
                <span class="text-muted">•</span>
                <a href="#" class="text-decoration-none text-muted mx-2">Yardım Merkezi</a>
                <span class="text-muted">•</span>
                <a href="#" class="text-decoration-none text-muted mx-2">Destek</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>